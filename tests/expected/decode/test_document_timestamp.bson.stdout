└── document <- bson.document :=
    └── elements <- repeat bson.element :=
        └── 0 <- bson.element :=
            └── timestamp <- bson.element.timestamp :=
                ├── key <- bson.cstring := { valid := "ts" }
                └── value <- { ... } :=
                    ├── increment <- ReadU32Le := 7
                    └── seconds <- ReadU32Le := 1577836800
