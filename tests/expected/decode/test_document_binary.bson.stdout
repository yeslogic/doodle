└── document <- bson.document :=
    └── elements <- repeat bson.element :=
        └── 0 <- bson.element :=
            └── binary <- bson.element.binary :=
                ├── key <- bson.cstring := { valid := "b" }
                └── value <- { ... } :=
                    ├── subtype <- ReadU8 := 0
                    └── data <- match subtype { ... } :=
