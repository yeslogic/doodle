-        )+
-    };
-    ( $( $t:ty => $( ( $fname:ident, $t1:ty ) ),+ $(,)? );+ $(;)? ) => {
-        $(
-            $(
-                #[inline]
-                pub fn $fname(x: $t) -> Eval<$t1> {
