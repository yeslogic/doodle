-    #[test]
-    fn one_plus_one_is_two() -> Result<(), EvalError> {
-        let one = TypedConst(BigInt::one(), NumRep::AUTO);
-        let should_be_two = Expr::BinOp(
-            BinOp {
-                op: BasicBinOp::Add,
-                out_rep: None,
-            },
-            Box::new(Expr::Const(one.clone())),
-            Box::new(Expr::Const(one)),
-        );
-        assert!(should_be_two
-            .eval()?
-            .as_const()
-            .unwrap()
-            .eq_num(&BigInt::from(2)));
-        Ok(())
-    }
