-#[derive(Clone, Copy, Debug)]
-enum BinOpClass<T> {
-    Pure(T),
-    HomWide(T, T),
-    HetWide(T, T, T),
-    HomLossy(T, T),
-    HetLossy(T, T, T),
-}
-
-#[derive(Clone, Copy, Debug)]
-enum UnaryOpClass<T> {
-    Pure(T),
-    NonLossy(T, T),
-    Lossy(T, T),
-}
